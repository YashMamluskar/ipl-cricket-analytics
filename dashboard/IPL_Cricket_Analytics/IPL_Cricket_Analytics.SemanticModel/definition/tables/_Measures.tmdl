	/// Full 20-over, non-D/L chases decided by runs or wickets.
	measure Chases = CALCULATE(COUNTROWS(FactMatch), FactMatch[is_chase_base] = 1)
		formatString: #,0
		displayFolder: 6 Match
		lineageTag: 3cdae376-c626-5785-81f1-df9d7a9f6eb6

	measure 'Chase Success %' = DIVIDE(CALCULATE(SUM(FactMatch[chase_won]), FactMatch[is_chase_base] = 1), [Chases])
		formatString: 0.0%
		displayFolder: 6 Match
		lineageTag: 7737b658-935c-519c-b7ea-51b99a9c5e53

	/// 95% Wilson interval lower bound.
	measure 'Chase Success CI Low' = VAR n = [Chases] VAR p = DIVIDE(CALCULATE(SUM(FactMatch[chase_won]), FactMatch[is_chase_base] = 1), n) VAR z = 1.959964 VAR den = 1 + z * z / n VAR c = (p + z * z / (2 * n)) / den VAR h = z * SQRT(p * (1 - p) / n + z * z / (4 * n * n)) / den RETURN IF(n > 0, MAX(0, c - h))
		formatString: 0.0%
		displayFolder: 6 Match
		lineageTag: a02fa429-9715-5e06-8d00-af69c4adc0ae

	measure 'Chase Success CI High' = VAR n = [Chases] VAR p = DIVIDE(CALCULATE(SUM(FactMatch[chase_won]), FactMatch[is_chase_base] = 1), n) VAR z = 1.959964 VAR den = 1 + z * z / n VAR c = (p + z * z / (2 * n)) / den VAR h = z * SQRT(p * (1 - p) / n + z * z / (4 * n * n)) / den RETURN IF(n > 0, MIN(1, c + h))
		formatString: 0.0%
		displayFolder: 6 Match
		lineageTag: d8a2a315-ec05-592f-8cef-a2d40cf8e2d6

	/// Average of (first-innings score - that season's league average), full matches.
	measure 'Avg First Innings vs Season' = AVERAGEX(FILTER(FactMatch, FactMatch[is_full_match] = 1), FactMatch[inn1_runs] - CALCULATE(AVERAGE(FactMatch[inn1_runs]), ALLEXCEPT(FactMatch, FactMatch[season_year]), FactMatch[is_full_match] = 1))
		formatString: +0.0;-0.0;0.0
		displayFolder: 6 Match
		lineageTag: 307f69be-734e-553d-ab88-31aedb10fd53

	/// 1 when the venue has 20+ full and 20+ decided matches.
	measure 'Venue Qualifies' = IF([Full Matches] >= 20 && [Decided Matches] >= 20, 1)
		formatString: 0
		displayFolder: 6 Match
		lineageTag: 662e08bc-fbef-53ea-b62b-50bc6de02b52

	measure 'Venue Full Matches (min 20)' = IF([Venue Qualifies] = 1, [Full Matches])
		formatString: #,0
		displayFolder: 6 Match
		lineageTag: da512cdf-c5dd-57ca-851d-1076c181beca

	measure 'Venue Avg First Innings (min 20)' = IF([Venue Qualifies] = 1, [Avg First Innings])
		formatString: 0.0
