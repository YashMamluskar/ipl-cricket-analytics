				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"match_id", "team_key", "opponent_team_key", "season_year", "venue_key", "batted_first", "won", "lost", "decided", "result_for", "is_super_over", "is_no_result", "is_dls", "is_playoff", "is_final", "won_toss", "is_close_match", "is_decided_bf_chase"}),
				    Blanks = Table.TransformColumns(Selected, List.Transform(Table.ColumnNames(Selected), (c) => {c, each if _ = "" then null else _})),
				    Typed = Table.TransformColumnTypes(Blanks, {{"match_id", Int64.Type}, {"team_key", Int64.Type}, {"opponent_team_key", Int64.Type}, {"season_year", Int64.Type}, {"venue_key", Int64.Type}, {"batted_first", Int64.Type}, {"won", Int64.Type}, {"lost", Int64.Type}, {"decided", Int64.Type}, {"result_for", type text}, {"is_super_over", Int64.Type}, {"is_no_result", Int64.Type}, {"is_dls", Int64.Type}, {"is_playoff", Int64.Type}, {"is_final", Int64.Type}, {"won_toss", Int64.Type}, {"is_close_match", Int64.Type}, {"is_decided_bf_chase", Int64.Type}}, "en-US")
